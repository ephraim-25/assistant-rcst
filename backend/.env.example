# Configuration de l'environnement backend RCST
GEMINI_API_KEY=
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ── Sécurité & base de données (production Vercel) ─────────────────────────
ENVIRONMENT=production
# Chaîne longue aléatoire (min. 32 caractères), ex. : python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# PostgreSQL hébergé (Supabase : Settings > Database > Connection pooling, mode « Transaction », port 6543)
DATABASE_URL=postgresql://USER:MOT_DE_PASSE@HOTE:6543/postgres
# Premier administrateur, créé au démarrage s'il n'existe pas (à définir dans Vercel, jamais dans Git)
ADMIN_EMAIL=
ADMIN_PASSWORD=
